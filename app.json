{
  "expo": {
    "name": "TenderGO",
    "slug": "tendergo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "tendergo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2740"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.dotrongtuan.tendergo",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f2740"
      },
      "package": "vn.dotrongtuan.tendergo",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ec5ef325-266d-4b5b-b0f4-fd11073bc7d8"
      }
    },
    "owner": "dotuanbk"
  }
}
